{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutrifit",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "nutrifit.kr", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 자산이 매칭되면 워커는 호출되지 않는다. dist/index.html 이 있으므로 "/" 도
    // 그대로 앱 셸이 나가 크롤러가 빈 문서를 본다. 홈만 워커를 먼저 태워
    // 사전렌더한 본문을 심어 내려보낸다(worker.ts 9번 분기).
    "run_worker_first": ["/", "/index.html"]
  },
  "observability": {
    "enabled": true
  }
}
