{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutrifit",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "nutrifit.kr", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
