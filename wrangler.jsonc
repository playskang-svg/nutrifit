{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "nutrifit-v2",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "a895a61b-8d7a-4827-9940-ba958fd7caaa",
      "database_name": "nutrifit",
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "nutrifit-media", "remote": true }],
  "triggers": { "crons": ["0 0,4,11 * * *"] }
}
